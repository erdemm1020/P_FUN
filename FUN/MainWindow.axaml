<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FUN.MainWindow"
        Title="FUN">
	<Grid ColumnDefinitions="*, 220">

		<!-- zone a droite avec le graphique  -->
		<sp:AvaPlot x:Name="MyPlot" Grid.Column="0" />

		<!-- Menu latéral -->
		<StackPanel Grid.Column="1" Background="#1e1e2e" Margin="0" Spacing="12">
			<StackPanel.Styles>
				<Style Selector="TextBlock">
					<Setter Property="Foreground" Value="#cdd6f4"/>
				</Style>
				<Style Selector="CheckBox">
					<Setter Property="Foreground" Value="#cdd6f4"/>
				</Style>
				<!-- Style pour rendre les boutons visibles et lisibles sur fond sombre -->
				<Style Selector="Button">
					<Setter Property="Background" Value="#313244"/>
					<Setter Property="Foreground" Value="#cdd6f4"/>
					<Setter Property="HorizontalContentAlignment" Value="Center"/>
				</Style>
				<!-- Effet au survol des boutons -->
				<Style Selector="Button:pointerover /template/ ContentPresenter">
					<Setter Property="Background" Value="#45475a"/>
					<Setter Property="TextElement.Foreground" Value="#ffffff"/>
				</Style>
			</StackPanel.Styles>

			<TextBlock Text="Menu aa" FontSize="16" FontWeight="Bold" Margin="12,16,12,0"/>

			<!-- Checkboxes -->
			<StackPanel x:Name="CityCheckBoxContainer" Spacing="5" Margin="12,0" />

			<!-- separator a droite -->
			<Border Height="1" Background="#313244" Margin="12,8"/>
			<!-- Boutons d'import -->
			<Button Content="Importer Fichier (CSV)" HorizontalAlignment="Stretch" Margin="12,0" Click="ImportFile_Click"/>


			<Border Height="1" Background="#313244" Margin="12,8"/>

			<!-- bouton dans le menu -->
			<StackPanel Orientation="Horizontal" Margin="12,0" Spacing="8">
				<ComboBox x:Name="ExportFormatComboBox" SelectedIndex="0" Foreground="#cdd6f4" Background="#313244">
					<ComboBoxItem Foreground="#cdd6f4">PNG</ComboBoxItem>
					<ComboBoxItem Foreground="#cdd6f4">CSV</ComboBoxItem>
				</ComboBox>
				<Button Content="Exporter" Click="ExportButton_Click"/>
			</StackPanel>
		</StackPanel>

	</Grid>
</Window>