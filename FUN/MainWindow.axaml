<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FUN.MainWindow"
        Title="FUN"
        Width="1200" Height="750" MinWidth="800" MinHeight="500"
        Background="#1e1e2e">
    <Grid>
        <!-- colonnes : graphique, séparateur déplaçable, menu -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="300" MinWidth="260" MaxWidth="450"/>
        </Grid.ColumnDefinitions>

        <!-- zone a droite avec le graphique  -->
        <Border Grid.Column="0" Margin="12" CornerRadius="10" ClipToBounds="True" Background="White">
            <sp:AvaPlot x:Name="MyPlot" />
        </Border>

        <!-- séparateur pour agrandir ou réduire le menu -->
        <GridSplitter Grid.Column="1" Background="#313244" ResizeDirection="Columns"/>

        <!-- Menu latéral -->
        <!-- thème sombre pour les champs du menu + barre de défilement -->
        <ThemeVariantScope Grid.Column="2" RequestedThemeVariant="Dark">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Background="#1e1e2e" Margin="14" Spacing="14">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="#cdd6f4"/>
                        </Style>
                        <Style Selector="CheckBox">
                            <Setter Property="Foreground" Value="#cdd6f4"/>
                        </Style>
                        <!-- Style pour rendre les boutons visibles et lisibles sur fond sombre -->
                        <Style Selector="Button">
                            <Setter Property="Background" Value="#313244"/>
                            <Setter Property="Foreground" Value="#cdd6f4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                        <!-- Effet au survol des boutons -->
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#45475a"/>
                            <Setter Property="TextElement.Foreground" Value="#cdd6f4"/>
                        </Style>
                        <!-- effet au clic des boutons -->
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#585b70"/>
                        </Style>
                        <!-- boutons importants en bleu -->
                        <Style Selector="Button.principal">
                            <Setter Property="Background" Value="#89b4fa"/>
                            <Setter Property="Foreground" Value="#1e1e2e"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style Selector="Button.principal:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#b4befe"/>
                            <Setter Property="TextElement.Foreground" Value="#1e1e2e"/>
                        </Style>
                        <Style Selector="Button.principal:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#74c7ec"/>
                        </Style>
                        <!-- cartes qui regroupent chaque section -->
                        <Style Selector="Border.carte">
                            <Setter Property="Background" Value="#181825"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Padding" Value="14"/>
                        </Style>
                        <!-- titres des sections -->
                        <Style Selector="TextBlock.titre">
                            <Setter Property="Foreground" Value="#89b4fa"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                        <!-- petits textes gris -->
                        <Style Selector="TextBlock.label">
                            <Setter Property="Foreground" Value="#a6adc8"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </StackPanel.Styles>

                    <TextBlock Text="Menu aa" FontSize="18" FontWeight="Bold"/>

					<!-- messages pour l'utilisateur -->
					<TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#a6e3a1" FontSize="12"/>

                    <!-- Checkboxes -->
                    <Border Classes="carte">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="titre" Text="Villes affichées"/>
                            <StackPanel x:Name="CityCheckBoxContainer" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <!-- filtre par date -->
                    <Border Classes="carte">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="titre" Text="Filtrer par date"/>
                            <TextBlock Classes="label" Text="Du"/>
                            <CalendarDatePicker x:Name="DateDebutPicker" HorizontalAlignment="Stretch" SelectedDateChanged="FiltreDate_Changed"/>
                            <TextBlock Classes="label" Text="Au"/>
                            <CalendarDatePicker x:Name="DateFinPicker" HorizontalAlignment="Stretch" SelectedDateChanged="FiltreDate_Changed"/>
                            <Button Content="Enlever le filtre" Margin="0,4,0,0" Click="EnleverFiltre_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- separator a droite -->
                    <Border Height="1" Background="#313244"/>
                    <!-- Boutons d'import et d'actualisation -->
                    <Border Classes="carte">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="titre" Text="Fichiers"/>
                            <Button Classes="principal" Content="Importer Fichier (CSV)" Click="ImportFile_Click"/>
                            <Button Content="Actualiser" Click="RefreshButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#313244"/>
                    <!-- ajout manuel d'une valeur -->
                    <Border Classes="carte">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Classes="titre" Text="Ajouter une valeur"/>
                            <TextBox x:Name="CityInputTextBox"
                                     Watermark="Nom de la ville" />
                            <CalendarDatePicker x:Name="DateInputPicker" HorizontalAlignment="Stretch" Watermark="Date" />

                            <TextBox x:Name="TemperatureInputTextBox"
                                     Watermark="Température (°C)" />

                            <Button Classes="principal"
                                    Content="Ajouter à la série"
                                    Click="AddDataButton_Click" />
                        </StackPanel>
                    </Border>

                    <!-- bouton dans le menu -->
                    <Border Classes="carte">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="titre" Text="Exporter"/>
                            <Grid ColumnDefinitions="*,8,*">
                                <ComboBox Grid.Column="0" x:Name="ExportFormatComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem>PNG</ComboBoxItem>
                                    <ComboBoxItem>CSV</ComboBoxItem>
                                </ComboBox>
                                <Button Grid.Column="2" Content="Exporter" Click="ExportButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- Boutons de zoom -->
                    <Border Classes="carte">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Classes="titre" Text="Navigation"/>
                            <!-- zoom + et zoom - côte à côte -->
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" Content="Zoom +" Click="ZoomInButton_Click" />
                                <Button Grid.Column="2" Content="Zoom -" Click="ZoomOutButton_Click" />
                            </Grid>
                            <Button Content="Recadrer la vue" Click="ResetViewButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ThemeVariantScope>

    </Grid>
</Window>